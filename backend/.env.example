# AWS DynamoDB Configuration
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=limitless-game

# Discord OAuth2 Configuration
# Create a Discord application at https://discord.com/developers/applications
# and replace these values with your actual credentials

DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback

# JWT Secret for token signing (generate a random secure string)
JWT_SECRET=your_very_long_random_secret_key_here_minimum_32_characters

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Optional: Set to 'production' for live deployment
ENVIRONMENT=development